rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Modelo de referência: NÃO publique regras abertas em produção.
    // O fluxo atual do site consulta e atualiza documentos em /keys/{keyId}.
    // Defina aqui as regras adequadas ao seu projeto (idealmente com Auth/App Check
    // e validação dos campos que podem ser alterados pelo cliente).
    match /keys/{keyId} {
      allow read, write: if false;
    }
  }
}
